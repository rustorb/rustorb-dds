<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Rustorb.Dds</AssemblyName>
    <RootNamespace>Rustorb.Dds</RootNamespace>
    <PackageId>Rustorb.Dds</PackageId>
    <Version>0.3.0</Version>
    <Authors>rustorb contributors</Authors>
    <Description>DDS for .NET on rustorb-dds: a subset of the DDS API after the Java 5 PSM, over the C ABI of librustorb_dds_ffi. Types come from rustorb-idl -bcsharp -Wbdds_only.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rustorb/rustorb-dds</PackageProjectUrl>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Omg.Types (ISequence<T>, Sequence<T>), which the code rustorb-idl
       -bcsharp -Wbdds_only writes uses for sequences: rustorb's small package
       without CORBA. -->
  <ItemGroup>
    <PackageReference Include="Rustorb.Types" Version="0.7.1" />
  </ItemGroup>

  <!-- The release workflow puts librustorb_dds_ffi of each platform into
       runtimes/<rid>/native here before dotnet pack. -->
  <ItemGroup>
    <None Include="runtimes/**" Pack="true" PackagePath="runtimes" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>

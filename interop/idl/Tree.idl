// A recursive type (DDS-XTypes 1.3, 7.3.4.8): a node holds a sequence of
// nodes. Its TypeObjects are identified by their strongly connected
// component (Tree::Node and Tree::NodeSeq).
module Tree {
  struct Node;
  typedef sequence<Node> NodeSeq;

  @appendable
  struct Node {
    long data;
    NodeSeq children;
  };
};

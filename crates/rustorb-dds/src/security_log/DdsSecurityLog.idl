// The type of the topic of the builtin logging plugin of DDS Security 1.2
// (10.6, DDS:Logging:DDS_LogTopic). The specification declares
// structured_data as map<string, NameValuePairSeq>; rustorb-idl has no
// maps, so it is the sequence of pairs here, which is serialized the same
// (DDS-XTypes 1.3, 7.4.3.5.3). dds_security_log.rs was generated from this
// with `rustorb-idl -brust -Wbdds_only -Wbxtypes`, and its description of
// structured_data then made the map.
module DDS {
module Security {
enum LoggingLevel {
    EMERGENCY_LEVEL,
    ALERT_LEVEL,
    CRITICAL_LEVEL,
    ERROR_LEVEL,
    WARNING_LEVEL,
    NOTICE_LEVEL,
    INFORMATIONAL_LEVEL,
    DEBUG_LEVEL
};

@extensibility(FINAL)
struct NameValuePair {
    string name;
    string value;
};
typedef sequence<NameValuePair> NameValuePairSeq;

struct Time_t {
    long long sec;
    unsigned long nanosec;
};

@extensibility(FINAL)
struct StructuredDataEntry {
    string key;
    NameValuePairSeq value;
};

@extensibility(APPENDABLE)
struct BuiltinLoggingTypeV2 {
    octet facility;
    LoggingLevel severity;
    Time_t timestamp;
    string hostname;
    string hostip;
    string appname;
    string procid;
    string msgid;
    string message;
    sequence<StructuredDataEntry> structured_data;
};
};
};

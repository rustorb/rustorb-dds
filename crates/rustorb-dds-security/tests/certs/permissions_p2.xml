<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="omg_shared_ca_permissions.xsd">
  <permissions>
    <grant name="p2">
      <subject_name>C=JP, O=rustorb, CN=participant2</subject_name>
      <validity>
        <not_before>2020-01-01T00:00:00</not_before>
        <not_after>2120-01-01T00:00:00</not_after>
      </validity>
      <allow_rule>
        <domains><id_range><min>0</min><max>230</max></id_range></domains>
        <publish><topics><topic>Square*</topic></topics></publish>
        <subscribe><topics><topic>Square*</topic></topics></subscribe>
      </allow_rule>
      <deny_rule>
        <domains><id>231</id></domains>
        <publish><topics><topic>*</topic></topics></publish>
      </deny_rule>
      <default>DENY</default>
    </grant>
  </permissions>
</dds>
